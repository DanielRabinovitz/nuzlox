{
  "name": "nuzlox",
  "version": "0.1.0",
  "description": "Nuzlox challenge website — official ruleset, teambuilder, forum, and playthrough tracker for the kosher Pokémon challenge.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/db-migrate.js",
    "seed": "node scripts/seed-dev.js",
    "seed:ruleset": "node scripts/seed-ruleset.js",
    "generate:cache": "node scripts/generate-ruleset-cache.js",
    "setup": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.7",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
