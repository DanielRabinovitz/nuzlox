<%# views/forum/topic.ejs — Topic thread with replies %>
<%# @ref wallbreaker/docs/accessibility/WCAG/03-understandable.md §3.3.2 (explicit labels on reply form) %>
<%# @ref wallbreaker/docs/accessibility/APXpatterns/challenge-patterns.md — Undo Redo (15-min grace window) %>

<div class="page-container">
  <p class="breadcrumb"><a href="/forum">Forum</a> › <%= topic.title %></p>

  <div class="page-header">
    <h1 class="page-header__title"><%= topic.title %></h1>
    <p class="page-header__meta">
      Started by <strong><%= topic.author_username || 'Unknown' %></strong>
      &middot;
      <time datetime="<%= topic.created_at %>">
        <%= new Date(topic.created_at).toLocaleDateString() %>
      </time>
      &middot; <%= topic.reply_count %> <%= topic.reply_count === 1 ? 'reply' : 'replies' %>
    </p>
  </div>

  <section class="reply-list" aria-label="Replies">
    <% if (!replies || replies.length === 0) { %>
      <p class="reply-list__empty">No replies yet. Be the first!</p>
    <% } else { %>
      <% replies.forEach((reply, i) => { %>
        <article
          class="reply-card <%= reply.is_ruling_precedent ? 'reply-card--ruling' : '' %>"
          id="reply-<%= reply.id %>"
          aria-label="Reply by <%= reply.author_username || 'Unknown' %>"
        >
          <header class="reply-card__header">
            <span class="reply-card__author"><strong><%= reply.author_username || '[deleted]' %></strong></span>
            <time class="reply-card__time" datetime="<%= reply.created_at %>">
              <%= new Date(reply.created_at).toLocaleString() %>
            </time>
            <% if (reply.is_ruling_precedent) { %>
              <span class="badge badge--ruling" title="This reply has been cited as official legal precedent">
                ✡ Ruling Precedent
              </span>
            <% } %>
          </header>
          <div class="reply-card__body">
            <%- reply.content.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>') %>
          </div>
          <footer class="reply-card__actions">
            <% if (currentUser) { %>
              <button
                class="btn btn--link btn--small"
                data-report-id="<%= reply.id %>"
                data-report-type="reply"
                type="button"
                aria-label="Report this reply"
              >Report</button>
            <% } %>
          </footer>
        </article>
      <% }) %>
    <% } %>
  </section>

  <% if (currentUser) { %>
    <section class="reply-form-section" aria-labelledby="reply-form-heading">
      <h2 class="reply-form-section__heading" id="reply-form-heading">Add a reply</h2>
      <form method="POST" action="/forum/<%= topic.slug %>/reply" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="content" class="form-label">Your reply</label>
          <textarea
            id="content"
            name="content"
            class="form-textarea"
            rows="6"
            required
            minlength="3"
            maxlength="10000"
            aria-describedby="reply-hint"
          ></textarea>
          <p class="form-hint" id="reply-hint">Keep it on-topic and respectful. This is a 13+ community.</p>
        </div>
        <%# WCAG §4.1.3 — submission result announced via flash region in partials/flash.ejs %>
        <button type="submit" class="btn btn--primary">Post reply</button>
      </form>
    </section>
  <% } else { %>
    <div class="reply-form-section notice notice--info">
      <p><a href="/register">Sign up</a> or <a href="/login">log in</a> to reply.</p>
    </div>
  <% } %>
</div>

<%# Report modal (Alpine.js) %>
<div x-data="reportModal()" id="report-modal-root">
  <div x-show="open" role="dialog" aria-modal="true" aria-label="Report content" class="modal-overlay"
       @keydown.escape="open = false">
    <div class="modal" @click.stop>
      <div class="modal__header">
        <h2 class="modal__title">Report Content</h2>
        <button class="modal__close" @click="open = false" aria-label="Close" type="button">✕</button>
      </div>
      <div class="modal__body">
        <form @submit.prevent="submit()">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="report-category" class="form-label">Reason</label>
            <select id="report-category" x-model="category" class="form-select" required>
              <option value="">— Select a reason —</option>
              <option value="illegal_content">Illegal content</option>
              <option value="spam">Spam</option>
              <option value="harassment">Harassment</option>
              <option value="off_topic">Off topic</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="report-description" class="form-label">Additional details (optional)</label>
            <textarea id="report-description" x-model="description" class="form-textarea" rows="3" maxlength="2000"></textarea>
          </div>
          <div x-show="submitted" role="status" aria-live="polite" class="notice notice--success">
            Report submitted. Thank you.
          </div>
          <button type="submit" class="btn btn--primary" :disabled="!category || submitted">Submit report</button>
        </form>
      </div>
    </div>
  </div>
  <div x-show="open" class="modal-backdrop" @click="open = false" aria-hidden="true"></div>
</div>

<script src="/js/forum.js" defer></script>
