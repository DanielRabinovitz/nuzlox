<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%# WCAG §2.4.2 — unique, descriptive page title per template %>
  <title><%= pageTitle || 'Nuzlox' %></title>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="stylesheet" href="/css/main.css">
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body>
  <%# WCAG §2.4.1 — skip-to-content link, first focusable element, visible on focus %>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <%- include('../partials/nav') %>

  <%# WCAG §4.1.3 — live region for flash messages %>
  <%- include('../partials/flash') %>

  <main id="main-content" tabindex="-1">
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <script src="https://unpkg.com/alpinejs@3.14.1/dist/cdn.min.js" defer></script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
