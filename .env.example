# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# In development (NODE_ENV=development) the app uses SQLite automatically.
# Set DB_DRIVER=mysql to use MySQL even in development.
DB_DRIVER=sqlite
# SQLite dev database path (relative to project root):
DB_SQLITE_PATH=data/dev.sqlite3

# MySQL credentials (only required when DB_DRIVER=mysql or NODE_ENV=production):
DB_HOST=localhost
DB_PORT=3306
DB_USER=nuzlox
DB_PASSWORD=
DB_NAME=nuzlox

# ── Email ────────────────────────────────────────────────────────────────────
# In development, emails are printed to the console (EMAIL_DRIVER=console).
# Set EMAIL_DRIVER=smtp and provide credentials for real sending.
EMAIL_DRIVER=console
EMAIL_FROM=noreply@nuzlox.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
